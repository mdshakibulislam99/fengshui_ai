# AMap API Configuration
# Get these from: https://console.amap.com/
AMAP_API_KEY=YOUR_AMAP_API_KEY_HERE
AMAP_SECURITY_KEY=YOUR_AMAP_SECURITY_KEY_HERE

# DeepSeek AI Chatbot API
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# OpenTopography API (optional if using DEM fallback only)
OPENTOPO_API_KEY=YOUR_OPENTOPO_API_KEY_HERE

# Flask Configuration
DEBUG=False
HOST=0.0.0.0
PORT=5000

# HydroSHEDS (Rivers) via Google Earth Engine
HYDROSHEDS_ENABLE=True
HYDROSHEDS_GEE_SERVICE_ACCOUNT_PATH=backend/dem/service_account.json
HYDROSHEDS_FLOW_ACC_DATASET=WWF/HydroSHEDS/15ACC
HYDROSHEDS_FLOW_ACC_THRESHOLD=1
HYDROSHEDS_PIXEL_SIZE_M=500
HYDROSHEDS_RADIUS_M=1000
